# Frontend Environment Variables
# Copy this file to .env and fill in your values

# Telegram Bot Configuration (no @ prefix required)
VITE_TELEGRAM_BOT_USERNAME=your_bot_username

# TON Connect Configuration
VITE_TON_CONNECT_MANIFEST_URL=https://your-domain.com/tonconnect-manifest.json

# API Configuration (include /api). Local default for npm run dev / mobile.
# GitHub Pages builds keep this default; override at runtime with ?api=https://your-tunnel/api
# (also persisted in localStorage as tapearn_api_base_url).
VITE_API_BASE_URL=http://localhost:3001/api

# App Configuration
VITE_APP_NAME=TapEarn
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG_MODE=false
