;; YORZA V3 — Non-Custodial TON Subscription Payment Router (testnet)
;; Validates backend-signed authorization, reserves fees, routes funds, prevents replay.
;; Commission is bound in the signed auth:
;;   commission > 0 → referrer gets commission, treasury gets remainder
;;   commission == 0 → full distributable to treasury (renewals / no referrer)
;; Bounce / stuck balance: signer-authorized sweep_excess → treasury (never assume dual send = settled).
;; NO admin pause / treasury mutation. MAINNET NOT DEPLOYED.

#include "imports/stdlib.fc";

int get_fwd_fee(int cells, int bits, int is_mc) impure inline asm "GETFORWARDFEE";

const int op::subscribe = 0x591a2b3c;
const int op::sweep_excess = 0x7a3e91d0;

const int error::unauthorized = 100;
const int error::expired = 101;
const int error::bad_signature = 102;
const int error::insufficient = 103;
const int error::replay = 104;
const int error::bad_commission = 105;
const int error::nothing_to_sweep = 106;

;; Outbound internal transfer (empty body) size for GETFORWARDFEE
const int OUT_MSG_BITS = 6 + 267 + 124 + 1 + 4 + 4 + 64 + 32 + 1 + 1;
const int OUT_MSG_CELLS = 1;

;; Execution reserve: signature verify + dict write
const int EXEC_BASE_GAS = 4000000;
const int EXEC_DICT_OP = 3500000;

global slice treasury_addr;
global int signer_pubkey;
global cell processed_dict;

() load_data() impure inline {
    slice ds = get_data().begin_parse();
    treasury_addr = ds~load_msg_addr();
    signer_pubkey = ds~load_uint(256);
    processed_dict = ds~load_dict();
}

() save_data() impure inline {
    set_data(begin_cell()
        .store_slice(treasury_addr)
        .store_uint(signer_pubkey, 256)
        .store_dict(processed_dict)
        .end_cell());
}

() send_empty_bounceable(slice dest, int amount) impure inline {
    var msg = begin_cell()
        .store_uint(0x18, 6)
        .store_slice(dest)
        .store_coins(amount)
        .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
        .end_cell();
    ;; mode 1 = pay forward fees from remaining balance after RAWRESERVE
    send_raw_message(msg, 1);
}

() recv_internal(int my_balance, int msg_value, cell in_msg_full, slice in_msg_body) impure {
    if (in_msg_body.slice_empty?()) { return (); }

    slice cs = in_msg_full.begin_parse();
    int flags = cs~load_uint(4);
    ;; Bounced payouts return value here; do not mark settled. Funds stay in contract until sweep_excess.
    if (flags & 1) { return (); }
    slice sender = cs~load_msg_addr();

    load_data();

    int op = in_msg_body~load_uint(32);

    if (op == op::sweep_excess) {
        ;; Signer-authorized rescue of bounced / leftover balance → treasury
        slice auth_slice = in_msg_body;
        int sweep_id = auth_slice~load_uint(256);
        int min_leave = auth_slice~load_coins();
        int expiry = auth_slice~load_uint(64);
        int nonce = auth_slice~load_uint(64);
        slice signature = null();
        if (auth_slice.slice_bits() >= 512) {
            signature = auth_slice~load_bits(512);
        } else {
            slice sig_slice = auth_slice~load_ref().begin_parse();
            signature = sig_slice~load_bits(512);
        }

        throw_unless(error::expired, expiry > now());

        (slice unused_sw, int already) = idict_get?(processed_dict, 256, sweep_id);
        throw_if(error::replay, already);

        cell auth_cell = begin_cell()
            .store_uint(op::sweep_excess, 32)
            .store_uint(sweep_id, 256)
            .store_coins(min_leave)
            .store_uint(expiry, 64)
            .store_uint(nonce, 64)
            .end_cell();
        throw_unless(error::bad_signature, check_signature(cell_hash(auth_cell), signature, signer_pubkey));

        int fwd_fee = get_fwd_fee(OUT_MSG_CELLS, OUT_MSG_BITS, 0);
        int execution_reserve = EXEC_BASE_GAS + EXEC_DICT_OP;
        raw_reserve(execution_reserve + min_leave, 0);
        int sendable = my_balance - execution_reserve - min_leave - fwd_fee;
        throw_unless(error::nothing_to_sweep, sendable > 0);

        processed_dict~idict_set(256, sweep_id, begin_cell().store_uint(1, 1).end_cell().begin_parse());
        save_data();
        send_empty_bounceable(treasury_addr, sendable);
        return ();
    }

    throw_unless(op == op::subscribe, 0xffff);

    slice auth_slice = in_msg_body;
    int payment_id = auth_slice~load_uint(256);
    slice subscriber = auth_slice~load_msg_addr();
    slice referrer = auth_slice~load_msg_addr();
    int amount = auth_slice~load_coins();
    int commission = auth_slice~load_coins();
    int expiry = auth_slice~load_uint(64);
    int nonce = auth_slice~load_uint(64);
    slice signature = null();
    if (auth_slice.slice_bits() >= 512) {
        signature = auth_slice~load_bits(512);
    } else {
        slice sig_slice = auth_slice~load_ref().begin_parse();
        signature = sig_slice~load_bits(512);
    }

    throw_unless(error::expired, expiry > now());
    throw_unless(error::unauthorized, equal_slice_bits(sender, subscriber));
    throw_unless(error::insufficient, msg_value == amount);

    (slice unused, int already_paid) = idict_get?(processed_dict, 256, payment_id);
    throw_if(error::replay, already_paid);

    cell auth_cell = begin_cell()
        .store_uint(payment_id, 256)
        .store_slice(subscriber)
        .store_slice(referrer)
        .store_coins(amount)
        .store_coins(commission)
        .store_uint(expiry, 64)
        .store_uint(nonce, 64)
        .end_cell();
    throw_unless(error::bad_signature, check_signature(cell_hash(auth_cell), signature, signer_pubkey));

    int out_count = 1;
    if (commission > 0) {
        out_count = 2;
    }
    int execution_reserve = EXEC_BASE_GAS + EXEC_DICT_OP;
    raw_reserve(execution_reserve, 0);

    int fwd_fee_one = get_fwd_fee(OUT_MSG_CELLS, OUT_MSG_BITS, 0);
    int outgoing_fees = fwd_fee_one * out_count;

    int distributable = amount - execution_reserve - outgoing_fees;
    throw_if(error::insufficient, distributable <= 0);
    throw_unless(error::bad_commission, (commission >= 0) & (commission <= distributable));

    ;; Mark processed BEFORE sends in the same transaction (atomic with compute success).
    ;; A later bounce does NOT clear this id — backend must treat PARTIALLY_SETTLED and sweep excess.
    processed_dict~idict_set(256, payment_id, begin_cell().store_uint(1, 1).end_cell().begin_parse());
    save_data();

    if (commission > 0) {
        int tre_share = distributable - commission;
        send_empty_bounceable(referrer, commission);
        send_empty_bounceable(treasury_addr, tre_share);
    } else {
        send_empty_bounceable(treasury_addr, distributable);
    }
}

int get_payment_processed(int payment_id) method_id {
    load_data();
    (slice val, int found) = idict_get?(processed_dict, 256, payment_id);
    return found;
}

slice get_treasury() method_id {
    load_data();
    return treasury_addr;
}
