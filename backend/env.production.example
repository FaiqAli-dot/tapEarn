# Production — Render Web Service (backend/)
# Copy to Render dashboard Environment or use render.yaml sync: false keys

NODE_ENV=production
PORT=10000

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=YORZAEARNBOT

# Mini App (full URL for bot web_app button)
FRONTEND_URL=https://faiqali-dot.github.io/tapEarn/
# Browser CORS origin (GitHub Pages — no path)
FRONTEND_ORIGINS=https://faiqali-dot.github.io

JWT_SECRET=
JWT_EXPIRES_IN=7d

ALLOW_DEV_AUTH=false
USE_MEMORY_MONGO=false

# MongoDB Atlas (required on Render — free tier works)
MONGODB_URI=
