# Backend Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3001
NODE_ENV=development

# Public Mini App URL (used by the bot web_app button)
FRONTEND_URL=http://localhost:5173

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username

# Session / JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Local browser testing WITHOUT Telegram initData.
# NEVER enable in production.
ALLOW_DEV_AUTH=true

# TON Blockchain Configuration (Phase 8 — not required yet)
TON_RPC_URL=https://toncenter.com/api/v2/jsonRPC
TON_CONTRACT_ADDRESS=EQ...
# Do not put real mnemonics in git. Prefer contract-side splits later.
# TON_WALLET_MNEMONIC=

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/tapearn
REDIS_URL=redis://localhost:6379

# Security Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

# Feature Flags
ENABLE_ANALYTICS=false
ENABLE_DEBUG_MODE=false
