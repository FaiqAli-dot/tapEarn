# Backend Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3001
NODE_ENV=development

# Public Mini App URL (used by the bot web_app button; path OK)
# Live Pages: https://faiqali-dot.github.io/tapEarn/
FRONTEND_URL=http://localhost:3000

# Optional extra CORS origins (comma-separated). Production always also allows
# http://localhost:3000 and https://faiqali-dot.github.io
# CORS_ORIGINS=https://your-tunnel.example.com

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username

# Session / JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Local browser testing WITHOUT Telegram initData.
# NEVER enable in production.
ALLOW_DEV_AUTH=true

# Use an in-memory MongoDB when you don't have mongod/Docker locally.
# Data is lost when the server stops.
USE_MEMORY_MONGO=true

# Database Configuration (ignored when USE_MEMORY_MONGO=true)
MONGODB_URI=mongodb://localhost:27017/tapearn
REDIS_URL=redis://localhost:6379

# Admin Telegram IDs (comma-separated). Required for /api/admin/* and /api/video-codes/*
ADMIN_TELEGRAM_IDS=123456789

# Payment webhook secret for POST /api/payments/complete (legacy YP referral hook)
PAYMENT_WEBHOOK_SECRET=change-me-payment-webhook-secret

# --- YORZA V2 TON testnet subscription (MAINNET NOT SUPPORTED) ---
TON_NETWORK=testnet
TON_SUBSCRIPTION_AMOUNT=0.1
TON_TESTNET_TREASURY_ADDRESS=0QBVP_9rEHfTB8iextldwtqq0ugRUtaccJioD8Z_gWSprS1T
TON_TESTNET_REFERRAL_CONTRACT_ADDRESS=0QDb2mg_3L8FMmA-wiX5c8Eec9PDz8OZVufWZMmdI7xUgJ3w
TON_TESTNET_RPC_URL=https://testnet.toncenter.com/api/v2
TONCENTER_API_KEY=
TON_CONNECT_DOMAIN=faiqali-dot.github.io
# Ed25519 hex (32-byte seed or 64-byte secret). NEVER commit real keys.
TON_PAYMENT_SIGNER_PRIVATE_KEY=
TON_PAYMENT_SIGNER_PUBLIC_KEY=b2fef7892defd10b586ebdb66da83c94e7a6faffbf23681d712193cd51494736
# Test-only: mock on-chain verification when tx hashes start with mock-
# TON_CHAIN_MOCK=true
# Deploy contract (testnet only — never mainnet):
# TON_DEPLOYER_MNEMONIC=

# Tap rate limit (requests per minute per user)
TAP_RATE_LIMIT_MAX=120

# General API rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

# Feature Flags
ENABLE_ANALYTICS=false
ENABLE_DEBUG_MODE=false
