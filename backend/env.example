# Backend Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3001
NODE_ENV=development

# Public Mini App URL (used by the bot web_app button)
# Local: http://localhost:3000 — Telegram mobile cannot open this; use DEV auth in browser.
# Production: your HTTPS Mini App URL (set in @BotFather → Bot Settings → Menu Button / Web App)
FRONTEND_URL=http://localhost:3000

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_USERNAME=YORZAEARNBOT

# Session / JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Local browser testing WITHOUT Telegram initData.
# NEVER enable in production.
ALLOW_DEV_AUTH=true

# Use an in-memory MongoDB when you don't have mongod/Docker locally.
# Data is lost when the server stops.
USE_MEMORY_MONGO=true

# Database Configuration (ignored when USE_MEMORY_MONGO=true)
MONGODB_URI=mongodb://localhost:27017/tapearn
REDIS_URL=redis://localhost:6379

# Security Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

# Feature Flags
ENABLE_ANALYTICS=false
ENABLE_DEBUG_MODE=false
